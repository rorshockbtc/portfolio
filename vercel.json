{
  "framework": "vite",
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/studio/index.html"
    },
    {
      "source": "/case-studies/:slug",
      "destination": "/case-studies/:slug/index.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
