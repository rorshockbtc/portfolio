{
  "framework": "vite",
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/studio", "destination": "https://colonhyphenbracket.pink/studio", "permanent": true },
    { "source": "/studio/:path*", "destination": "https://colonhyphenbracket.pink/studio", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/case-studies/:slug",
      "destination": "/case-studies/:slug/index.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
